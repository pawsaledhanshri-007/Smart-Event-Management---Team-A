PROJECT_NAME="Agentic AI Smart Event Management System"
API_V1_STR="/api"

# Database
# Use your actual local PostgreSQL database URL for development
DATABASE_URL=postgresql://user:password@localhost:5432/events_db

# Security
# Run `openssl rand -hex 32` to generate a secure secret key
SECRET_KEY=your-super-secret-key-that-should-be-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440
